# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
env/
venv/
.venv/

# Environment / secrets
.env

# IDE / editor configs
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db

# Project runtime outputs (keep sample_logs/ tracked)
outputs/logs/
outputs/videos/
*.mp4

# CSV outputs — keep only the curated sample log
*.csv
!outputs/sample_logs/output.csv

# Model weights (large binary; distribute via GitHub Releases)
# *.pt
assets/models/*.pt

# Jupyter
.ipynb_checkpoints/

# Word documents (use the PDF in docs/ instead)
*.docx
*.doc
