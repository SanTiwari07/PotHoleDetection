# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
env/
venv/
.venv/

# Environment / secrets
.env
!.env.example
ESP_32_Code/**/credentials.h

# IDE / editor configs
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db

# Project runtime outputs (keep sample_logs/ tracked)
outputs/logs/
outputs/videos/
*.mp4

# CSV outputs — keep only the curated sample log
*.csv
!outputs/sample_logs/output.csv
!KiCad/**/fabrication/*.csv

# Model weights (large binary; distributed via GitHub Releases, auto-downloaded on first run)
*.pt

# Jupyter
.ipynb_checkpoints/

# Word documents (use the PDF in docs/ instead)
*.docx
*.doc

# KiCad autosave / cache files
*-backups/
fp-info-cache
*.kicad_prl
_autosave-*
*.lck

# Gradio demo cache
.gradio/
flagged/

# Training data and runs
datasets/
runs/

# GitHub Pages build output
_site/
