(text "IPDS Sensor Node: ESP32 + MPU6050 + DS3231 + NEO-6M" (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "4ca991c7-033c-5e7a-8c67-ba00c4cd1462"))
(text "I2C bus: SDA = GPIO21, SCL = GPIO22, 4.7k pull-ups R1/R2 to 3V3" (exclude_from_sim no) (at 20.32 172.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c03111e2-ef2f-53bb-8420-9046d3443ee1"))
(text "MPU6050 AD0 tied to 3V3 -> I2C address 0x69 (DS3231 RTC uses 0x68)" (exclude_from_sim no) (at 20.32 176.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "65248b8a-5680-564e-912e-e54435255426"))
(text "GPS on UART2 @ 9600 baud: GPIO16 (RX2) <- GPS TX, GPIO17 (TX2) -> GPS RX" (exclude_from_sim no) (at 20.32 180.34 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5d6db5b1-3fce-5e17-bc54-0b2b77f69b03"))
(text "Power: 5V into J1 (via D1) or the DevKit USB. Don't use both unless your DevKit has a USB isolation diode." (exclude_from_sim no) (at 20.32 184.15 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6eb1e34c-dd23-5e91-bb00-c611179d3445"))
