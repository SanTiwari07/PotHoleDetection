# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# `.env` is git-ignored, so your credentials never leave your machine.

# WiFi network that BOTH ESP32 boards and your laptop connect to (e.g. a phone hotspot).
# After editing, run `python update_wifi.py` to generate the firmware credentials.h files.
WIFI_SSID=YourNetworkName
WIFI_PASSWORD=YourPassword

# IP addresses printed on the Serial Monitor (115200 baud) after flashing each board.
ESP32_CAM_IP=192.168.1.50
ESP32_SENSOR_IP=192.168.1.51
